/* MENU STICKY */
header.sticky {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
}/* SLIDER */
.slider {
    position: relative;
    overflow: hidden;
    max-width: 800px;
    margin: 20px auto;
    min-height: 80px;
}

.slide {
    display: none;
    font-size: 1.2rem;
    padding: 20px;
    background-color: #fff;
    border-radius: 10px;
    box-shadow: 0px 5px 15px rgba(0,0,0,0.1);
}

.slide.active {
    display: block;
    animation: fade 1s ease-in-out;
}

/* Animation fade */
@keyframes fade {
    from {opacity: 0;}
    to {opacity: 1;}
}
