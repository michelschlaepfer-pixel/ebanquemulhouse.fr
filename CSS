/* MENU STICKY */
header.sticky {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
}/* SLIDER */
.slider {
    position: relative;
    overflow: hidden;
    max-width: 800px;
    margin: 20px auto;
    min-height: 80px;
}

.slide {
    display: none;
    font-size: 1.2rem;
    padding: 20px;
    background-color: #fff;
    border-radius: 10px;
    box-shadow: 0px 5px 15px rgba(0,0,0,0.1);
}

.slide.active {
    display: block;
    animation: fade 1s ease-in-out;
}

/* Animation fade */
@keyframes fade {
    from {opacity: 0;}
    to {opacity: 1;}
}
/* ANIMATIONS AU SCROLL */
section {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
}

section.visible {
    opacity: 1;
    transform: translateY(0);
}

/* Bouton plus élégant */
button {
    background-color: #1a3d7c; /* bleu profond */
    color: #fff;
    border: none;
    padding: 12px 30px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.3s ease;
}

button:hover {
    background-color: #ffcc33; /* touche dorée */
    color: #1a3d7c;
}

/* Carte Services plus élégante */
.card {
    background-color: #fff;
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    flex: 1 1 250px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 25px rgba(0,0,0,0.15);
}

/* Couleurs prestige */
body {
    background-color: #f9f9f9;
    color: #1a3d7c;
}

header, footer {
    background-color: #1a3d7c;
    color: #fff;
}